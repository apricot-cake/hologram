{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/typescript/tests.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noUncheckedSideEffectImports": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "typeRoots": ["../node_modules/@types", "../app/node_modules/@types", "../extension/node_modules/@types"],
    "types": ["node", "chrome"],
    "paths": {
      "@/*": ["../app/src/renderer/src/*"]
    }
  },
  "include": ["../app/**/*.test.ts", "../extension/**/*.test.ts", "../native-host/**/*.test.ts", "../scripts/**/*.test.ts", "integration/**/*.test.ts", "helpers/**/*.ts", "../app/src/renderer/src/types/**/*.d.ts", "../extension/types/globals.d.ts"],
  "exclude": [
    "integration/archive-db-export.test.ts",
    "integration/archive-db-import.test.ts",
    "../extension/utils/background-wiring.test.ts",
    "integration/bridge-ssrf.test.ts",
    "integration/bulk-capture.extension-bundle.test.ts",
    "integration/content-fixtures.test.ts",
    "../app/src/renderer/contrast-parity.test.ts",
    "integration/db-schema.test.ts",
    "integration/db-write.test.ts",
    "integration/db.test.ts",
    "../scripts/electron-path-guard.test.ts",
    "integration/extension-tokens.test.ts",
    "../app/src/main/folder-nesting.test.ts",
    "integration/folders-merge.test.ts",
    "../app/src/renderer/src/services/image-zoom.test.ts",
    "integration/lib-db-integrity.test.ts",
    "../app/src/renderer/src/services/listing.test.ts",
    "../extension/utils/extractor/metadata-correctness.test.ts",
    "../extension/utils/extractor/metadata-origin.test.ts",
    "integration/migrate.test.ts",
    "../app/src/renderer/src/services/records.test.ts",
    "../scripts/sandbox-instance.test.ts",
    "integration/sandbox-real-seed.test.ts",
    "../extension/utils/save-error-i18n.test.ts",
    "../app/src/main/save-folder-guard.test.ts",
    "integration/save-post-video.test.ts",
    "../scripts/schema-canary.test.ts",
    "../app/src/renderer/src/services/tabstate.test.ts",
    "integration/transfer-roundtrip.test.ts",
    "../app/src/renderer/src/services/users.test.ts",
    "../scripts/verify-record.test.ts"
  ]
}
