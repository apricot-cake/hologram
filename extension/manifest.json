{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "host_permissions": ["https://cdn.syndication.twimg.com/*", "https://www.pixiv.net/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://bsky.app/*", "https://www.pixiv.net/*", "https://pixiv.net/*"],
      "js": ["i18n.js", "glass-ui.js", "site-detect.js", "media-identity.js", "overlay.js", "drag.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "activate": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_cmdActivate__"
    }
  }
}
