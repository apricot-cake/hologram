{
  "name": "hologram-extension",
  "private": true,
  "version": "1.1.0",
  "description": "Hologram browser extension (MV3), built by CRXJS and Vite",
  "type": "module",
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "scripts": {
    "dev": "npm run tokens && vite --mode chrome",
    "build": "npm run build:chrome",
    "build:chrome": "npm run tokens && vite build --mode chrome",
    "build:firefox": "npm run tokens && vite build --mode firefox",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ../scripts/patch-crxjs-runtime-reload.cts",
    "tokens": "node ../scripts/gen-extension-tokens.cts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "^0.2.2",
    "typescript": "^7.0.2",
    "vite": "8.2.0"
  }
}
