{
  "name": "hologram-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Hologram browser extension (MV3), built by WXT",
  "type": "module",
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "npm run tokens && wxt build -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "tokens": "node ../scripts/gen-extension-tokens.cts"
  },
  "dependencies": {
    "@marbec/web-auto-extractor": "2.2.1",
    "entities": "8.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "wxt": "0.21.4"
  }
}
