{
  "name": "hologram-extension",
  "private": true,
  "version": "1.1.0",
  "description": "Hologram browser extension (MV3), built by WXT",
  "type": "module",
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "scripts": {
    "dev": "npm run tokens && wxt",
    "build": "npm run build:chrome",
    "build:chrome": "npm run tokens && wxt build -b chrome",
    "build:firefox": "npm run tokens && wxt build -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare",
    "tokens": "node ../scripts/gen-extension-tokens.cts"
  },
  "dependencies": {
    "@marbec/web-auto-extractor": "2.2.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "wxt": "0.21.3"
  }
}
