{
  "name": "hologram-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Hologram browser extension (MV3), built by WXT",
  "type": "module",
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "npm run tokens && wxt build -b chrome",
    "typecheck": "npm run prepare:types && tsc -b",
    "postinstall": "wxt prepare",
    "tokens": "node ../scripts/gen-extension-tokens.cts",
    "prepare:types": "wxt prepare"
  },
  "dependencies": {
    "@marbec/web-auto-extractor": "2.2.1",
    "entities": "8.1.0",
    "lucide": "^1.50.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "wxt": "0.21.4"
  }
}
