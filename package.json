{
  "name": "hologram-dev",
  "private": true,
  "version": "0.0.0",
  "description": "dev tooling deps (e2e capture tests)",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.62.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.0",
    "jszip": "3.10.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.24",
    "vitest": "^4.1.10",
    "ws": "^8.18.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "scripts": {
    "build:ext": "node scripts/build-extension.cts",
    "tokens:ext": "node scripts/gen-extension-tokens.cts",
    "test:overlay-visual": "npm run build:ext && node scripts/e2e-overlay-visual.cts",
    "test:overlay-flicker": "npm run build:ext && node scripts/e2e-overlay-flicker.cts",
    "test:e2e-extension": "npm run build:ext && node scripts/e2e-extension-offline.cts",
    "test:e2e-duplicate": "npm run build:ext && node scripts/e2e-extension-duplicate.cts",
    "test:e2e-timeout": "npm run build:ext && node scripts/e2e-extension-timeout.cts",
    "test:e2e-save-log": "npm run build:ext && node scripts/e2e-extension-save-log.cts",
    "test:e2e-hostile-css": "npm run build:ext && node scripts/e2e-extension-hostile-css.cts",
    "test:e2e-inject-failure": "npm run build:ext && node scripts/e2e-extension-inject-failure.cts",
    "test:e2e-orphan": "npm run build:ext && node scripts/e2e-extension-orphan.cts",
    "test:e2e-banner-layout": "node scripts/e2e-extension-banner-layout.cts",
    "dev:ext:server": "npm --prefix extension run dev",
    "dev:ext": "node scripts/extension-dev-supervisor.cts run",
    "ext:status": "node scripts/extension-dev-supervisor.cts status",
    "ext:restart": "node scripts/extension-dev-supervisor.cts restart",
    "ext:recover": "node scripts/extension-dev-supervisor.cts recover",
    "ext:register": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/register-extension-dev-task.ps1",
    "zip:ext": "node scripts/zip-extension.cts",
    "setup": "node scripts/setup.cts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:flow": "playwright test --project=flow",
    "test:e2e:update": "playwright test --project=visual --update-snapshots",
    "typecheck": "node scripts/typecheck.cts",
    "check": "npm run lint && npm run typecheck && npm test"
  }
}
