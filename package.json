{
  "name": "hologram-dev",
  "private": true,
  "version": "0.0.0",
  "description": "dev tooling deps (e2e capture tests)",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.0",
    "jszip": "3.10.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.26",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "js-yaml": "^4.3.1",
    "sharp": "0.35.3"
  },
  "scripts": {
    "build:ext": "node scripts/build-extension.cts",
    "build:ext:test": "node scripts/build-test-extension.cts",
    "deploy:ext": "node scripts/deploy-extension.cts",
    "dev:ext": "node scripts/dev-extension.cts",
    "ext:dev:browser": "node scripts/open-dev-profile.cts",
    "ext:dev:cdp": "node scripts/open-dev-profile.cts --print",
    "ext:dev:marker": "node scripts/open-dev-profile.cts --marker",
    "ext:dev:register": "node scripts/register-dev-native-host.cts",
    "tokens:ext": "node scripts/gen-extension-tokens.cts",
    "test:overlay-visual": "npm run build:ext:test && node scripts/e2e-overlay-visual.cts",
    "test:overlay-flicker": "npm run build:ext:test && node scripts/e2e-overlay-flicker.cts",
    "test:e2e-extension": "npm run build:ext:test && node scripts/e2e-extension-offline.cts",
    "test:e2e-duplicate": "npm run build:ext:test && node scripts/e2e-extension-duplicate.cts",
    "test:e2e-timeout": "npm run build:ext:test && node scripts/e2e-extension-timeout.cts",
    "test:e2e-save-log": "npm run build:ext:test && node scripts/e2e-extension-save-log.cts",
    "test:e2e-hostile-css": "npm run build:ext:test && node scripts/e2e-extension-hostile-css.cts",
    "test:e2e-inject-failure": "npm run build:ext:test && node scripts/e2e-extension-inject-failure.cts",
    "test:e2e-orphan": "npm run build:ext:test && node scripts/e2e-extension-orphan.cts",
    "test:e2e-banner-layout": "node scripts/e2e-extension-banner-layout.cts",
    "zip:ext": "node scripts/zip-extension.cts",
    "setup": "node scripts/setup.cts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:extension": "npm run build:ext:test && vitest run --config vitest.extension.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:flow": "playwright test --project=flow",
    "test:e2e:update": "playwright test --project=visual --update-snapshots",
    "typecheck": "node scripts/typecheck.cts",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:extension": "npm run check && npm run test:extension",
    "check:release": "npm run build:ext",
    "check:ci": "npm run lint:ci && npm run typecheck && npm test && npm run test:extension && npm run check:release"
  }
}
