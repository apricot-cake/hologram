{
  "name": "hologram-dev",
  "private": true,
  "version": "0.0.0",
  "description": "Hologram development tooling",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "undici": "^8.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.62.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "classic-level": "^3.0.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.0",
    "jszip": "3.10.1",
    "playwright": "^1.62.0",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "js-yaml": "^4.3.2",
    "sharp": "0.35.3"
  },
  "scripts": {
    "build:ext": "node scripts/build-extension.cts",
    "build:ext:test": "node scripts/build-test-extension.cts",
    "deploy:ext": "node scripts/deploy-extension.cts",
    "deploy:app": "node scripts/deploy-app.cts",
    "ext:dev:browser": "node scripts/open-dev-profile.cts",
    "ext:dev:cdp": "node scripts/open-dev-profile.cts --print",
    "ext:dev:marker": "node scripts/open-dev-profile.cts --marker",
    "ext:dev:register": "node scripts/register-dev-native-host.cts",
    "tokens:ext": "node scripts/gen-extension-tokens.cts",
    "test:overlay-visual": "npm run build:ext:test && playwright test --project=extension overlay-visual",
    "test:overlay-flicker": "npm run build:ext:test && playwright test --project=extension overlay-flicker",
    "test:e2e-hostile-css": "npm run build:ext:test && playwright test --project=extension extension-hostile-css",
    "test:e2e-orphan": "npm run build:ext:test && playwright test --project=extension extension-orphan",
    "zip:ext": "node scripts/zip-extension.cts",
    "setup": "node scripts/setup.cts",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:extension": "npm run build:ext:test && vitest run --config vitest.extension.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:flow": "playwright test --project=flow",
    "test:e2e:update": "playwright test --project=visual --update-snapshots",
    "typecheck": "npm run prepare:types --prefix extension && tsc -b",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:extension": "npm run check && npm run test:extension",
    "check:release": "npm run build:ext",
    "check:ci": "npm run lint:ci && npm run typecheck && npm test && npm run test:extension && npm run check:release",
    "test:e2e:harness": "playwright test --project=harness --workers=4",
    "pretest:e2e:process": "npm run build:ext:test",
    "test:e2e:process": "playwright test --project=harness --project=extension --workers=4",
    "test:e2e-extension": "npm run build:ext:test && playwright test --project=extension --workers=4",
    "app:freeze": "node scripts/local-app.cts freeze",
    "app:fixed": "node scripts/local-app.cts fixed",
    "app:development": "node scripts/local-app.cts development",
    "app:verify": "node scripts/local-app.cts verify",
    "diag:extension": "node scripts/read-extension-diagnostics.cts",
    "app:bookmarks": "node scripts/local-app.cts bookmarks"
  }
}
