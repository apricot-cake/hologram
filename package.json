{
  "name": "hologram-dev",
  "private": true,
  "version": "0.0.0",
  "description": "dev tooling deps (e2e capture tests)",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.0",
    "jszip": "3.10.1",
    "playwright": "^1.62.0",
    "vitest": "^4.1.10",
    "ws": "^8.18.3"
  },
  "scripts": {
    "build:ext": "npm --prefix extension run build:ext",
    "dev:ext": "npm --prefix extension run dev:ext",
    "test:overlay-visual": "npm run build:ext && node scripts/e2e-overlay-visual.cts",
    "test:overlay-flicker": "npm run build:ext && node scripts/e2e-overlay-flicker.cts",
    "test:e2e-extension": "npm run build:ext && node scripts/e2e-extension-offline.cts",
    "zip:ext": "npm --prefix extension run zip",
    "setup": "node scripts/setup.cts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck.cts",
    "check": "npm run lint && npm run typecheck && npm test"
  }
}
