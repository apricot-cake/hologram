{
  "name": "hologram-dev",
  "private": true,
  "version": "0.0.0",
  "description": "Hologram development tooling",
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.2",
    "classic-level": "^3.0.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "jszip": "3.10.2",
    "markdownlint-cli2": "0.23.3",
    "playwright": "^1.62.0",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "js-yaml": "^4.3.2",
    "sharp": "0.35.3"
  },
  "scripts": {
    "ext:build": "node scripts/build-extension.cts",
    "ext:build:test": "node scripts/build-test-extension.cts",
    "ext:deploy": "node scripts/deploy-extension.cts",
    "app:deploy": "node scripts/deploy-app.cts",
    "ext:dev:open": "node scripts/open-dev-profile.cts",
    "ext:dev:status": "node scripts/open-dev-profile.cts --print",
    "ext:dev:open:marker": "node scripts/open-dev-profile.cts --marker",
    "ext:dev:register": "node scripts/register-dev-native-host.cts",
    "ext:tokens": "node scripts/gen-extension-tokens.cts",
    "test:ext:overlay:visual": "npm run ext:build:test && playwright test --project=extension-regression overlay-visual",
    "test:ext:overlay:flicker": "npm run ext:build:test && playwright test --project=extension-regression overlay-flicker",
    "test:ext:hostile-css": "npm run ext:build:test && playwright test --project=extension-regression extension-hostile-css",
    "test:ext:orphan": "npm run ext:build:test && playwright test --project=extension-regression extension-orphan",
    "ext:package": "node scripts/zip-extension.cts",
    "setup": "node scripts/setup.cts",
    "lint": "biome check . && npm run lint:markdown && npm run lint:typos",
    "lint:ci": "biome ci . && npm run lint:markdown",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "markdownlint-cli2 --fix",
    "lint:typos": "typos",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:content": "node scripts/guard-repository-content.cts --staged",
    "prepare:search-engine": "node scripts/prepare-meilisearch.mjs",
    "test": "vitest run",
    "test:ext": "npm run ext:build:test && vitest run --config vitest.extension.config.ts",
    "test:e2e:ci": "playwright test --project=flow --project=harness --project=extension",
    "test:e2e:app": "playwright test --project=flow",
    "test:e2e:regression": "playwright test --project=flow-regression --project=extension-regression --project=visual",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "typecheck": "npm run prepare:types --prefix extension && tsc -b",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:ext": "npm run check && npm run test:ext",
    "release:ext:verify": "npm run ext:build",
    "check:ci": "npm run prepare:search-engine && npm run lint:ci && npm run typecheck && npm test && npm run test:ext && npm run release:ext:verify",
    "test:e2e:harness": "playwright test --project=harness --workers=4",
    "test:e2e:process": "playwright test --project=harness --project=extension --workers=4",
    "pretest:integration": "npm run ext:build:test",
    "test:integration": "playwright test --project=harness --project=extension --workers=4",
    "test:e2e:ext": "npm run ext:build:test && playwright test --project=extension --workers=4",
    "start": "npm run app:launch",
    "app:launch": "npm run _launch --workspace=app",
    "app:debug": "node scripts/local-app.cts verify",
    "app:dev": "npm run _dev --workspace=app",
    "app:build": "npm run _build --workspace=app",
    "app:package": "npm run _package --workspace=app",
    "app:make": "npm run _make --workspace=app",
    "app:publish": "npm run _publish --workspace=app",
    "diag:capture": "node scripts/summarize-capture-timings.cts",
    "diag:extension": "node scripts/read-extension-diagnostics.cts"
  }
}
