{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sweep-orphan-worktrees.mjs\"",
            "statusMessage": "sweeping orphan worktree shells"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commit-heredoc.js\"",
            "statusMessage": "checking commit syntax"
          }
        ]
      }
    ]
  }
}
