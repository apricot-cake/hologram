.claude/settings.local.json
node_modules/
app/node_modules/
app/dist/
app/artifacts/
app/out/
# Rebuilt from src/renderer/src/services/theme.ts by `npm run build:theme-boot`
# (part of app's build/dev scripts) — no longer hand-committed (was, pre-#156).
app/src/renderer/public/theme.js
app/.deploy-*/
app/.deploy-lock
app/.deployed-build.json
app/.deployed-build.json.tmp
extension/node_modules/
extension/.output/
extension/.wxt/
native-host/dist/
app/.smoke-shot*.png
app/.theme-*.png
app/.ia-*.png
app/.b1-*.png
__pycache__/
# design-brief/ design-export/ は UI 刷新の原資料。実装取り込み済みで作業ツリーからは git rm 済み（git 履歴に残置＝再生成不可だが履歴から復元可）
# 使い捨てスクリプト/検証スクショは _ 接頭辞で除外（2026-07-09: 旧 _verify-*.js の
# 追跡例外は廃止＝TS化スコープの棚卸しで手書き .js の温床と判明・20本削除）
scripts/_*.js
scripts/_*.jpg
scripts/_*.png
# Isolated verification instance (scripts/sandbox-app.cts): config + seeded library
.sandbox/
.local-app/
# Per-run reload probe instances (scripts/probe-gpu-reload.cts): config + seeded library + samples.json
.probe66/
# Playwright の実行成果物（失敗時のトレース・レポート）。ベースライン画像
# (e2e/**/*-snapshots/) はコミット対象なので除外しない。
test-results/
playwright-report/
# UI 検証の一時成果物。通常は %LOCALAPPDATA%\Hologram\verification に出すが、
# 強制追加や古いスクリプトによる混入にも備えてリポジトリ内の置き場を除外する。
tmp/
verification/
captures/
screenshots/
recordings/
# 秘密ファイルのトリップワイヤ（現状コミット済み秘密は無い・鍵/config はリポ外の config ディレクトリ＝Windows は %APPDATA%\Hologram）。
# 将来の人的ミスで秘密が混入するのを先回りで防ぐ。正当ファイルを誤って隠したら ! で個別解除。
*.pem
*.key
.env
.env.*
/config.json

app/vendor/meilisearch/
app/vendor/avif/
