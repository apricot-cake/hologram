// Biome 設定（lint+format の単一ツール）
//
// バージョンは 1.9.4 に固定: 2.x は設定書式が変わるうえ新ルールの指摘が多数出る
// ため、移行は単独の作業として #18 で扱う。
//
// 方針: Biome を既存コードのスタイルに合わせる（逆ではない）。lineWidth を
// 大きく取り再折返しチャーンを避ける＝既存のコード参照と git blame を守る。
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      // 生成物（ビルド出力＝コミットされているが手書きでない）
      "app/renderer/islands/**",
      // 同上（theme.ts の Vite lib IIFE ビルド出力・renderer/theme.ts が手書きソース）
      "app/renderer/theme.js",
      // WXT の拡張機能ビルド出力
      "extension/.output/**",
      "extension/.wxt/**",
      // 同上（preload.cts の Vite lib CJS ビルド出力・app/preload.cts が手書きソース）
      "app/preload.js",
      // ベンダー同梱・ロックファイル・package.json（npm が所有＝再インストールの
      // たびに npm 形式へ書き戻され Biome と書式ピンポンになるため対象外）
      "app/vendor/**",
      "**/package-lock.json",
      "**/package.json",
      // 並行エージェントセッションの worktree（別チェックアウト＝そちらの
      // ワーキングツリーをこちらの lint が赤にしない）
      ".claude/**"
    ]
  },
  // import 並べ替えは今はしない（チャーン優先度が低い・必要なら別途）
  "organizeImports": { "enabled": false },
  "overrides": [
    {
      // tsconfig.json は Biome が既知名として JSONC 扱いするが、プロジェクト分割の
      // tsconfig.*.json（main プロセス用等）は名前で認識されない＝コメント可を明示。
      "include": ["**/tsconfig.*.json"],
      "json": { "parser": { "allowComments": true, "allowTrailingCommas": true } }
    },
    {
      // shadcn/ui の生成部品は vendored 扱い（app/vendor/** と同格）。upstream は
      // useState の安定 setter を dep 配列へ防御的に含める書き方で、Biome は
      // useExhaustiveDependencies で「余分」と赤にする。無害な余剰 dep のために
      // 再生成のたび upstream から fork するのは保守負債＝この規則だけこの配下で
      // 無効化する（他の正しさ系は有効のまま）。
      "include": ["app/islands/components/ui/**"],
      "linter": {
        "rules": {
          "correctness": { "useExhaustiveDependencies": "off" }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    // 既存コードは密な長行スタイル（1行 if / 連結式）が主流。幅での強制折返しは
    // しない＝320 は事実上「折り返さない」の意。
    "lineWidth": 320
  },
  // CSS は対象外: design-tokens.css は「1トークン=1行・light/dark ブロック対」の
  // 手組み構造で、test-token-parity / test-contrast-parity がこの書式を正規表現で
  // 解析する（＝整形はテストの前提を壊す）。CSS の大半は index.html 内で元々対象外。
  "css": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // 無効化はすべて「リポの意図的イディオム/方針との衝突」。正しさ系は全て有効のまま。
      "a11y": {
        // デスクトップアプリとして a11y/キーボード操作を目標に掲げていないため
        // 一括で無効化している。指摘は 21 件（2026-07-22 実測）で、方針を変える
        // 場合は全体を戻すのでなくルール単位で有効化する。
        "recommended": false
      },
      "style": {
        "useTemplate": "off", // 文字列連結が主流イディオム（360件）＝置換は無価値なチャーン
        "useSingleVarDeclarator": "off", // let a, b; スタイルを許容
        "noParameterAssign": "off" // 引数の正規化再代入（v = coerce(v)）は常用パターン
      },
      "complexity": {
        "useOptionalChain": "off", // a && a.b イディオムが 245 箇所（2026-07-22 実測）＝一括書換は blame を汚すだけで得るものがない
        "noForEach": "off", // forEach は許容
        "useArrowFunction": "off" // function 式は hoisting/this 都合で意図的な箇所あり
      },
      "suspicious": {
        "noAssignInExpressions": "off", // while ((m = re.exec())) 等のイディオム
        "noArrayIndexKey": "off", // 島はモデル丸ごと再pushで index key が正（部分並べ替えをしない）
        "noRedundantUseStrict": "off", // Biome は .js を ESM 扱い＝CJS/plain-script の 'use strict' は本物。削ると sloppy 化の実害
        // 明示 any が 380 箇所（2026-07-22 実測）。境界を越えるペイロード（IPC・
        // 拡張⇄ホスト間のメッセージ）の契約として意図的に置いたものを含むため、
        // 有効化するなら段階的な型付けとセットで行う。
        "noExplicitAny": "off"
      },
      "performance": {
        "noDelete": "off" // delete はサイドカー/JSON のキー除去の正道（性能文脈でない）
      }
    }
  }
}
