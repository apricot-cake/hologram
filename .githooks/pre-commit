#!/bin/sh
# Auto-format staged files before commit (#994).
#
# `biome check --write` doesn't fail on fixable violations — it fixes them
# and keeps going, so a commit is never blocked for something Biome can
# repair itself. Only a violation Biome cannot auto-fix stops the commit.
# Restricted to staged files so files with unrelated unstaged edits aren't
# rewritten, and --no-errors-on-unmatched keeps an all-non-Biome commit
# (e.g. only a .png) from failing just because nothing matched.
#
# The package entry point is invoked with Node, not through npx or the generated
# shell wrapper: a fresh linked worktree has no
# node_modules until `npm run setup` runs, and `npx biome` there goes to the
# registry — a commit that hangs on a download, or fails outright when offline.
# Formatting is a convenience, so a missing install skips it rather than
# blocking the commit.
#
# Runs when a repository-specific hook path points here directly or delegates here.
# Skip with `git commit --no-verify` if this gets in the way.

set -u

if [ -z "$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)" ]; then
  exit 0
fi

if ! node scripts/guard-repository-content.cts --staged; then
  exit 1
fi

biome=node_modules/@biomejs/biome/bin/biome
if [ ! -f "$biome" ]; then
  echo "[hologram] biome is not installed here — skipping the pre-commit format (run: npm run setup)" >&2
else
  # Biome reads and writes the working tree even with --staged. Formatting a
  # partially staged file and then running `git add` would therefore include
  # the developer's intentionally unstaged hunks in the commit. Only format
  # files whose working-tree content already matches the index; partially
  # staged files can be formatted once their remaining changes are staged.
  failure_marker="${TMPDIR:-/tmp}/hologram-pre-commit-$$"
  rm -f "$failure_marker"
  trap 'rm -f "$failure_marker"' EXIT HUP INT TERM
  git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR |
    while IFS= read -r file; do
      if ! git diff --quiet -- "$file"; then
        echo "[hologram] skipping partially staged file: $file" >&2
        continue
      fi

      if ! node "$biome" check --write --no-errors-on-unmatched -- "$file"; then
        touch "$failure_marker"
        continue
      fi

      git add -- "$file" || touch "$failure_marker"
    done

  if [ -f "$failure_marker" ]; then
    echo "[hologram] biome found a violation it could not auto-fix. Fix it, or commit with --no-verify to skip." >&2
    exit 1
  fi
fi
