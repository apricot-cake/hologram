'use strict';

// Performance harness for #5 (SQLite真実源化) — built as #293 St0, kept as the
// standing measurement tool.
//
// Runs headless (no Electron) against a library generated by
// scripts/gen-dummy-library.cts (#175) or any real save folder + database.
//
// The BEFORE numbers (the sidecar/lib-index scan this replaced) are recorded in #5's
// 2026-07-23 comment and are reproducible from commit 3c6d118c, where that code
// still existed. This harness no longer carries a sidecar adapter: #302 deleted the
// scan, and keeping a copy of it alive here just to re-measure it would be exactly
// the leftover #302 set out to remove.
//
// Scenarios measured (#293 body):
//   cold      — open the database fresh and read every post (an app launch)
//   warm      — the same against an already-open handle (a refresh); with no on-disk
//               index to rebuild, cold and warm collapsing together IS the result
//   incremental — rewrite a small % of posts through writePost (a capture landing)
//   search    — representative free-text / tag / platform-facet / combined-AND
//               queries via the real query engine (app/src/renderer/src/services/query.ts + search.ts)
//   facets    — facetCounts() bucket aggregation (app/src/renderer/src/services/facets.ts)
//   fts       — FTS5 free-text search through searchPostsFts (the DB-native path the
//               in-memory matcher above is the comparison point for)
//   ipc       — v8.serialize()/deserialize() of the full posts array (Electron's
//               contextBridge/ipcRenderer use the V8 structured-clone algorithm,
//               NOT JSON — v8.serialize gives the same wire format and its real
//               byte length, unlike JSON.stringify().length)
//
// Methodology (2026-07-22 issue comment — cites BenchmarkDotNet Good Practices,
// Google Benchmark reducing_variance.md, JMH, hyperfine, Criterion):
//   - Numbers are comparable ONLY within one recording (same machine, same load
//     state) — never diff across machines/runs. Environment is recorded with every
//     report for exactly this reason; a before/after diff must use two reports with
//     matching environment blocks.
//   - warm-up iterations run and are discarded before measured iterations (let
//     JIT/OS file-cache/GC settle) — counts are explicit CLI params, not buried.
//   - KNOWN LIMITATION: "cold" here means a fresh database handle — there is no
//     portable, unprivileged way to drop the OS page cache from plain Node
//     (hyperfine's --prepare shells out to platform-specific tools this harness
//     doesn't have). Disk-cache state across runs is real variance this harness
//     cannot control; it is a documented gap, not a silently-ignored one.
//   - Outliers are reported (min/max), never dropped — a warning prints when max
//     exceeds 2x the mean.
//
//   node scripts/bench-baseline.cts <libraryDir> [options]
//
// Options:
//   --db FILE              database to measure (default <libraryDir>/hologram.db)
//   --warmup N            discarded iterations before measuring (default 2)
//   --iterations N         measured iterations per scenario (default 5)
//   --incremental-pct N   percent of posts rewritten for the incremental scenario (default 1)
//   --out FILE             also write the JSON report to FILE
//   --generator-hash HASH  #175 generator identity to record verbatim (optional; this
//                          harness also self-computes a library content hash — see
//                          "generator" in the report — so this is a supplement, not
//                          the only provenance check)

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const crypto = require('node:crypto');
const v8 = require('node:v8');
const { execFileSync } = require('node:child_process');
const { pathToFileURL } = require('node:url');
const { openDatabase } = require('../app/src/main/lib-db.ts');
const { postsByIds, postsFromDb, searchPostsFts } = require('../app/src/main/lib-db-query.ts');
const { makeTagResolver, preparePostStmts, writePost } = require('../app/src/main/lib-db-record-writer.ts');

function parseArgs(argv) {
  const opts = { warmup: 2, iterations: 5, incrementalPct: 1, out: null, generatorHash: null, libraryDir: null, db: null };
  const rest = argv.slice(2);
  for (let i = 0; i < rest.length; i++) {
    const a = rest[i];
    if (a === '--warmup') opts.warmup = Number(rest[++i]);
    else if (a === '--iterations') opts.iterations = Number(rest[++i]);
    else if (a === '--incremental-pct') opts.incrementalPct = Number(rest[++i]);
    else if (a === '--out') opts.out = rest[++i];
    else if (a === '--generator-hash') opts.generatorHash = rest[++i];
    else if (a === '--db') opts.db = rest[++i];
    else if (a.startsWith('--')) throw new Error(`Unknown option: ${a}`);
    else if (!opts.libraryDir) opts.libraryDir = a;
    else throw new Error(`Unexpected argument: ${a}`);
  }
  if (!opts.libraryDir) throw new Error('Missing <libraryDir>. Usage: node scripts/bench-baseline.cts <libraryDir> [--db FILE] [--warmup N] [--iterations N] [--incremental-pct N] [--out FILE] [--generator-hash HASH]');
  if (!Number.isFinite(opts.warmup) || opts.warmup < 0) throw new Error('--warmup must be >= 0');
  if (!Number.isFinite(opts.iterations) || opts.iterations < 1) throw new Error('--iterations must be >= 1');
  return opts;
}

// --- measurement primitive: warmup discarded, N measured, report stats + outlier warning.
async function measure(name: string, fn: () => Promise<{ ms: number; extra?: any }>, { warmup, iterations }: { warmup: number; iterations: number }) {
  for (let i = 0; i < warmup; i++) await fn();
  const values: { ms: number; extra?: any }[] = [];
  for (let i = 0; i < iterations; i++) values.push(await fn());
  const ms = values.map((v) => v.ms);
  const min = Math.min(...ms);
  const max = Math.max(...ms);
  const mean = ms.reduce((a, b) => a + b, 0) / ms.length;
  const warn = max > mean * 2 ? `outlier: max ${max.toFixed(1)}ms > 2x mean ${mean.toFixed(1)}ms (not dropped, shown as-is)` : null;
  return { name, warmup, iterations, msValues: ms, min, max, mean, warning: warn, extra: values[values.length - 1].extra };
}

function nowMs() {
  return Number(process.hrtime.bigint()) / 1e6;
}

// --- the measurement target: the library's own database ---------------------
// coldScan opens a fresh handle (a launch), warmScan reuses the open one (a
// refresh). Both then read every post through postsFromDb, which is exactly what
// index.ts's listPosts()/listPostsDelta() do. Nothing is re-derived from disk on
// the way: that IS the change #302 measured.
let _handle: any = null;
function closeHandle() {
  if (_handle) {
    try {
      _handle.sqlite.close();
    } catch {
      /* already closed */
    }
    _handle = null;
  }
}
async function coldScan(dbFile: string) {
  closeHandle();
  const t0 = nowMs();
  _handle = openDatabase(dbFile);
  const posts = await postsFromDb(_handle.sqlite);
  return { posts, ms: nowMs() - t0 };
}
async function warmScan() {
  const t0 = nowMs();
  const posts = await postsFromDb(_handle.sqlite);
  return { posts, ms: nowMs() - t0 };
}

// Rewrite `pct`% of the posts through the shared writer — the same work a capture
// landing does (posts + media + post_tags + the FTS5 row). Reads them back first so
// the rewrite carries real content rather than a stub. Returns the ids touched.
async function rewritePosts(sqlite: any, ids: string[], pct: number) {
  const n = Math.max(1, Math.round((ids.length * pct) / 100));
  const step = Math.max(1, Math.floor(ids.length / n));
  const picked: string[] = [];
  for (let i = 0; i < ids.length && picked.length < n; i += step) picked.push(ids[i]);
  const records = await postsByIds(sqlite, picked);
  const stmts = preparePostStmts(sqlite);
  const resolveTagId = makeTagResolver(sqlite);
  const t0 = nowMs();
  sqlite.exec('BEGIN');
  for (const rec of records) writePost(stmts, resolveTagId, rec);
  sqlite.exec('COMMIT');
  return { ms: nowMs() - t0, touched: picked.length };
}

// --- environment + generator provenance ---
function gitRevOf(file) {
  try {
    return execFileSync('git', ['log', '-1', '--format=%H', '--', file], { cwd: path.join(__dirname, '..'), encoding: 'utf8' }).trim() || null;
  } catch {
    return null;
  }
}

function environmentInfo() {
  const cpus = os.cpus();
  return {
    hostname: os.hostname(),
    platform: process.platform,
    release: os.release(),
    arch: process.arch,
    cpuModel: cpus[0] ? cpus[0].model : null,
    cpuCount: cpus.length,
    totalMemGB: +(os.totalmem() / 1073741824).toFixed(1),
    nodeVersion: process.version,
    repoCommit: gitRevOf('.') || null,
  };
}

// Hash the generated library's actual bytes (sorted filenames + contents), so a
// baseline number can be checked against "was this really the same data" later —
// #175 has no --validate option (2026-07-22 comment), so this harness does its own
// content hash rather than trusting seed/count alone (a generator change that keeps
// the same CLI args can still change output bytes).
function libraryContentHash(dir) {
  const names = fs
    .readdirSync(dir)
    // The database is excluded on purpose: the incremental scenario writes to it,
    // so hashing it would make the provenance number differ between two runs of
    // the same harness over the same generated library.
    .filter((f) => !/\.db(-wal|-shm)?$/i.test(f) && fs.statSync(path.join(dir, f)).isFile())
    .sort();
  const h = crypto.createHash('sha256');
  for (const f of names) {
    h.update(f);
    h.update(fs.readFileSync(path.join(dir, f)));
  }
  return { hash: h.digest('hex'), fileCount: names.length };
}

// --- search / facets scenarios: pick representative queries FROM the actual data
// (not hand-picked constants) so the harness stays meaningful at any scale/seed. ---
function pickRepresentative(posts: any[]) {
  const tagFreq = new Map();
  const platFreq = new Map();
  const words: string[] = [];
  for (const p of posts) {
    for (const t of p.tags || []) tagFreq.set(t, (tagFreq.get(t) || 0) + 1);
    platFreq.set(p.platform || '__none', (platFreq.get(p.platform || '__none') || 0) + 1);
    if (p.text && words.length < 5000) {
      const w = String(p.text)
        .split(/[^\p{L}\p{N}]+/u)
        .filter((x) => x.length >= 3);
      if (w.length) words.push(w[0]);
    }
  }
  const topTag = [...tagFreq.entries()].sort((a, b) => b[1] - a[1])[0];
  const topPlat = [...platFreq.entries()].sort((a, b) => b[1] - a[1])[0];
  const word = words.length ? words[Math.floor(words.length / 2)] : null;
  return { tag: topTag ? topTag[0] : null, platform: topPlat ? topPlat[0] : null, textTerm: word };
}

async function runSearchAndFacets(posts: any[], opts: { warmup: number; iterations: number }) {
  const Q = await import(pathToFileURL(path.join(__dirname, '..', 'app', 'src', 'renderer', 'src', 'services', 'query.ts')).href);
  const S = await import(pathToFileURL(path.join(__dirname, '..', 'app', 'src', 'renderer', 'src', 'services', 'search.ts')).href);
  const F = await import(pathToFileURL(path.join(__dirname, '..', 'app', 'src', 'renderer', 'src', 'services', 'facets.ts')).href);

  const rep = pickRepresentative(posts);
  const predOf = Q.makePostPredOf({ isInFolder: () => false, fuzzyCompile: (q) => S.compile(q) });

  const results: Record<string, any> = {};
  const scenarios: [string, any][] = [];
  if (rep.textTerm) scenarios.push(['text:' + rep.textTerm, { kind: 'cond', type: 'text', value: rep.textTerm }]);
  if (rep.tag) scenarios.push(['tag:' + rep.tag, { kind: 'cond', type: 'tag', value: rep.tag }]);
  if (rep.platform) scenarios.push(['platform:' + rep.platform, { kind: 'cond', type: 'platform', value: rep.platform }]);
  if (rep.tag && rep.platform)
    scenarios.push([
      'platform+tag AND',
      {
        kind: 'group',
        op: 'and',
        neg: false,
        children: [
          { kind: 'cond', type: 'platform', value: rep.platform },
          { kind: 'cond', type: 'tag', value: rep.tag },
        ],
      },
    ]);

  for (const [label, leaf] of scenarios) {
    results[label] = await measure(
      label,
      async () => {
        const t0 = nowMs();
        let hits = 0;
        for (const p of posts) if (Q.evalNode(leaf, p, predOf)) hits++;
        return { ms: nowMs() - t0, extra: { hits } };
      },
      opts,
    );
  }

  // facetCounts — bucket aggregation over the whole library (sidebar facet panel shape).
  const facetDeps = {
    getFilteredPosts: () => posts,
    allPosts: () => posts,
    qHasValue: () => false,
    posterQHasValue: () => false,
    hostOf: Q.hostOf,
    userKey: Q.userKey,
    t: () => '',
    PF_NAME: {},
    tagKindOf: () => undefined,
    multiOnly: () => false,
    posterTagsOf: () => [],
    filteredPosters: () => [],
    posterFilterVocab: () => [],
    namedPosters: () => [],
    posterFolders: () => [],
    buildUsers: () => [],
  };
  const { facetCounts } = F.makeFacets(facetDeps);
  results['facets:platform'] = await measure(
    'facets:platform',
    async () => {
      const t0 = nowMs();
      const m = facetCounts((p) => p.platform || '__none');
      return { ms: nowMs() - t0, extra: { buckets: m.size } };
    },
    opts,
  );
  results['facets:tag'] = await measure(
    'facets:tag',
    async () => {
      const t0 = nowMs();
      const m = facetCounts((p) => p.tags);
      return { ms: nowMs() - t0, extra: { buckets: m.size } };
    },
    opts,
  );

  return { representative: rep, results };
}

// --- IPC-equivalent scenario: node:v8 structured-clone serialize/deserialize —
// the same algorithm Electron's contextBridge/ipcRenderer use, so byte length and
// timing here approximate the real IPC cost (JSON.stringify().length would not:
// different wire format, different size). ---
function runIpcScenario(posts: any[], opts: { warmup: number; iterations: number }) {
  return measure(
    'ipc:v8-serialize-roundtrip',
    async () => {
      const t0 = nowMs();
      const buf = v8.serialize(posts);
      const back = v8.deserialize(buf);
      const ms = nowMs() - t0;
      return { ms, extra: { bytes: buf.length, postsRoundTripped: back.length } };
    },
    opts,
  );
}

async function main() {
  const opts = parseArgs(process.argv);
  const dir = path.resolve(opts.libraryDir);
  if (!fs.existsSync(dir)) throw new Error(`libraryDir not found: ${dir}`);

  const dbFile = path.resolve(opts.db || path.join(dir, 'hologram.db'));
  if (!fs.existsSync(dbFile)) throw new Error(`database not found: ${dbFile} (generate one with scripts/gen-dummy-library.cts, or pass --db)`);
  console.log(`bench-baseline: ${dir}  db=${dbFile}  warmup=${opts.warmup} iterations=${opts.iterations}`);

  const report: Record<string, any> = {
    environment: environmentInfo(),
    generator: { hashArg: opts.generatorHash, library: libraryContentHash(dir), generatorScriptCommit: gitRevOf('scripts/gen-dummy-library.cts') },
    params: { warmup: opts.warmup, iterations: opts.iterations, incrementalPct: opts.incrementalPct },
    db: dbFile,
    scenarios: {},
  };

  // cold — each measured iteration opens the database from scratch.
  let lastColdPosts: any = null;
  report.scenarios.cold = await measure(
    'cold',
    async () => {
      const r = await coldScan(dbFile);
      lastColdPosts = r.posts;
      return { ms: r.ms, extra: { postCount: r.posts.length } };
    },
    opts,
  );

  // warm — same read against the handle the last cold iteration left open.
  report.scenarios.warm = await measure(
    'warm',
    async () => {
      const r = await warmScan();
      return { ms: r.ms, extra: { postCount: r.posts.length } };
    },
    opts,
  );

  // incremental — rewrite a slice of the library, the work one capture landing does.
  const allIds = lastColdPosts.map((p: any) => p.captureId);
  report.scenarios.incremental = await measure(
    'incremental',
    async () => {
      const r = await rewritePosts(_handle.sqlite, allIds, opts.incrementalPct);
      return { ms: r.ms, extra: { touchedCount: r.touched } };
    },
    opts,
  );

  const { representative, results: searchResults } = await runSearchAndFacets(lastColdPosts, opts);
  report.searchRepresentative = representative;
  report.scenarios = { ...report.scenarios, ...searchResults };
  report.scenarios.ipc = await runIpcScenario(lastColdPosts, opts);

  // FTS5 rank contract (#297's query contract). The "search:*" scenarios above are
  // the in-memory-fuzzy-matcher comparison point.
  if (representative.textTerm) {
    const sqlite = _handle.sqlite;
    report.scenarios['fts:' + representative.textTerm] = await measure(
      'fts:' + representative.textTerm,
      async () => {
        const t0 = nowMs();
        const hits = searchPostsFts(sqlite, representative.textTerm);
        return { ms: nowMs() - t0, extra: { hits: hits.length } };
      },
      opts,
    );
  }

  for (const [name, s] of Object.entries(report.scenarios as Record<string, any>)) {
    const w = s.warning ? `  ⚠ ${s.warning}` : '';
    console.log(`  ${name.padEnd(22)} min=${s.min.toFixed(1)}ms mean=${s.mean.toFixed(1)}ms max=${s.max.toFixed(1)}ms${w}`);
  }

  closeHandle();

  const json = JSON.stringify(report, null, 2);
  if (opts.out) {
    fs.writeFileSync(opts.out, json);
    console.log(`report written to ${opts.out}`);
  }
  console.log(json);
}

main().catch((err) => {
  process.stderr.write(`bench-baseline: ${err.stack || err.message}\n`);
  process.exit(1);
});
