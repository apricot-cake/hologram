{
  // TypeScript stage 2 (BACKLOG 採用#1「残り②」): checkJs over the build-less
  // plain-JS renderer SERVICE layer (the viewer.js extraction slices + store),
  // plus viewer.ts itself (converted from .js 2026-07-06 — it folds into the
  // app.js Vite bundle, so tsc here is type-check-only: noEmit, Vite strips types
  // at build). Contract-visibility for the plain-JS files; the remaining .js
  // service modules convert to .ts as 単一バンドル化 puts them under Vite. Opt-in
  // is by explicit "files" so each module enters checked, not aspirationally.
  //
  // noImplicitAny is ON (2026-07-09): the service layer is fully typed now —
  // this project is strict-equivalent to islands' tsconfig.json, clearing the
  // way to merge the two into a single TS project (see 実プロダクト化の残課題 in
  // the backlog memory).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "files": [
    "renderer/types/renderer-globals.d.ts",
    "islands/types/globals.d.ts",
    "renderer/i18n.ts",
    "renderer/ui.ts",
    "renderer/ipc.ts",
    "renderer/theme.ts",
    "renderer/bridge.ts",
    "renderer/search.ts",
    "renderer/menu.ts",
    "renderer/kind-menu.ts",
    "renderer/qf-pop.ts",
    "renderer/filter-popover.ts",
    "renderer/searchbox.ts",
    "renderer/grid.ts",
    "renderer/shell.ts",
    "renderer/about-icon.ts",
    "renderer/query.ts",
    "renderer/records.ts",
    "renderer/facets.ts",
    "renderer/cooc.ts",
    "renderer/tags.ts",
    "renderer/users.ts",
    "renderer/tab-state.ts",
    "renderer/listing.ts",
    "renderer/geometry.ts",
    "renderer/format.ts",
    "renderer/undo.ts",
    "renderer/search-editing.ts",
    "renderer/query-chips.ts",
    "renderer/store.ts",
    "renderer/folders.ts",
    "renderer/inspector.ts",
    "renderer/edit-overlay.ts",
    "renderer/sidebar.ts",
    "renderer/selection.ts",
    "renderer/bulk-edit.ts",
    "renderer/confirm.ts",
    "renderer/trash.ts",
    "renderer/backup.ts",
    "renderer/posts.ts",
    "renderer/posts-data.ts",
    "renderer/image-tab.ts",
    "renderer/tabs.ts",
    "renderer/viewer.ts"
  ]
}
