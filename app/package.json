{
  "name": "corpus-app",
  "version": "1.1.0",
  "description": "Corpus desktop viewer",
  "main": "main.mts",
  "author": "apricot-cake",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npm run build:islands && electron-builder",
    "register-host": "node ../native-host/install.cts",
    "unregister-host": "node ../native-host/install.cts uninstall",
    "build:islands": "node islands/build.mjs",
    "dev:renderer": "vite",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.1.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.corpus.app",
    "productName": "Corpus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mts",
      "preload.js",
      "ipc-backup.mts",
      "ipc-config.mts",
      "ipc-organize.mts",
      "ipc-posts.mts",
      "ipc-transfer.mts",
      "ipc-trash.mts",
      "ipc-window.mts",
      "backup-guard.mts",
      "lib-archive.mts",
      "lib-imgsize.mts",
      "lib-index.mts",
      "lib-json.mts",
      "lib-migrate.mts",
      "renderer/**/*",
      "vendor/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../native-host",
        "to": "native-host"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "jszip": "3.10.1",
    "masonic": "^4.1.0"
  }
}
