{
  "name": "hologram-app",
  "version": "1.1.0",
  "description": "Hologram desktop viewer",
  "repository": "https://github.com/apricot-cake/hologram",
  "main": "./out/main/index.js",
  "author": "apricot-cake",
  "license": "MIT",
  "scripts": {
    "start": "node ../scripts/local-app.cts launch",
    "build:theme-boot": "node build-theme-boot.mjs",
    "build:native-host-bridge": "node build-native-host-bridge.mjs",
    "dev": "node ../scripts/prepare-meilisearch.mjs && npm run build:theme-boot && npm run build:native-host-bridge && electron-vite dev --watch",
    "build": "node ../scripts/prepare-meilisearch.mjs && npm run build:theme-boot && npm run build:native-host-bridge && electron-vite build",
    "package:deps": "npm install --omit=dev --workspaces=false --package-lock=false --legacy-peer-deps",
    "package:clean": "npm --prefix .. install",
    "package": "npm run build && npm run package:deps && node ../scripts/package-app.cjs && npm run package:clean",
    "make": "npm run package && electron-forge make --skip-package",
    "publish": "npm run make && electron-forge publish --skip-package",
    "register-host": "node ../native-host/install.mts",
    "unregister-host": "node ../native-host/install.mts uninstall",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.3",
    "electron-vite": "^5.0.0",
    "koffi": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.4.4",
    "image-size": "^2.0.4",
    "intl-messageformat": "^11.2.14",
    "kysely": "^0.29.6",
    "lucide-react": "^1.47.0",
    "masonic": "^4.1.0",
    "meilisearch": "^0.62.0",
    "react-image-crop": "^11.1.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "update-electron-app": "3.3.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  }
}
