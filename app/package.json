{
  "name": "hologram-app",
  "version": "1.1.0",
  "description": "Hologram desktop viewer",
  "main": "./out/main/index.js",
  "author": "apricot-cake",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:theme-boot": "node build-theme-boot.mjs",
    "build:native-host-bridge": "node build-native-host-bridge.mjs",
    "dev": "npm run build:theme-boot && npm run build:native-host-bridge && electron-vite dev",
    "build": "npm run build:theme-boot && npm run build:native-host-bridge && electron-vite build",
    "dist": "npm run build && electron-builder",
    "register-host": "node ../native-host/install.cts",
    "unregister-host": "node ../native-host/install.cts uninstall",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "koffi": "^3.1.2",
    "react": "^19.1.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.hologram.app",
    "productName": "Hologram",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../native-host",
        "to": "native-host"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "kysely": "^0.29.4",
    "lucide-react": "^1.24.0",
    "masonic": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wanakana": "^5.3.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
