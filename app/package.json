{
  "name": "corpus-app",
  "version": "1.1.0",
  "description": "Corpus desktop viewer",
  "main": "main.js",
  "author": "apricot-cake",
  "scripts": {
    "start": "electron .",
    "dist": "npm run build:islands && electron-builder",
    "register-host": "node ../native-host/install.js",
    "unregister-host": "node ../native-host/install.js uninstall",
    "build:islands": "node islands/build.mjs",
    "dev:renderer": "vite"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.1.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.1.0",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.corpus.app",
    "productName": "Corpus",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "preload.js", "lib-archive.js", "lib-index.js", "renderer/**/*", "vendor/**/*", "assets/**/*"],
    "extraResources": [
      {
        "from": "../native-host",
        "to": "native-host"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "masonic": "^4.1.0"
  }
}
