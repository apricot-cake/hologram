{
  "name": "corpus-app",
  "version": "1.1.0",
  "description": "Corpus desktop viewer",
  "main": "main.mts",
  "author": "apricot-cake",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "npm run build:islands && electron-builder",
    "register-host": "node ../native-host/install.cts",
    "unregister-host": "node ../native-host/install.cts uninstall",
    "build:islands": "node islands/build.mjs",
    "dev:renderer": "vite",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.1.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.1.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.corpus.app",
    "productName": "Corpus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mts",
      "preload.js",
      "ipc-backup.mts",
      "ipc-config.mts",
      "ipc-organize.mts",
      "ipc-posts.mts",
      "ipc-transfer.mts",
      "ipc-trash.mts",
      "ipc-window.mts",
      "backup-guard.mts",
      "lib-archive.mts",
      "lib-imgsize.mts",
      "lib-index.mts",
      "lib-json.mts",
      "lib-migrate.mts",
      "renderer/**/*",
      "vendor/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../native-host",
        "to": "native-host"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jszip": "3.10.1",
    "lucide-react": "^1.24.0",
    "masonic": "^4.1.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
