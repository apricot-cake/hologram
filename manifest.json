{
  "manifest_version": 3,
  "name": "Eagle Metadata Enhancer",
  "version": "0.2.0",
  "description": "SNSの投稿者情報をEagleのメタデータとして自動注入",
  "permissions": [],
  "host_permissions": [
    "http://localhost:41595/*",
    "https://public.api.bsky.app/*",
    "https://cdn.syndication.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://bsky.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["page-context.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
