{
  // TypeScript stage 2, native-host half (BACKLOG 採用#1「残り②」= P3): the
  // native-messaging-host layer (bridge.cts + install.cts + paths.cts +
  // media-download.cts + config-recovery.cts).
  //
  // Separate project from tsconfig.node.json / tsconfig.web.json because
  // this is a THIRD runtime: a standalone Node process (spawned by Chrome via
  // native messaging, or via the Electron binary in ELECTRON_RUN_AS_NODE mode),
  // never imported by ESM import — only by CommonJS require() (computed-path
  // from app/src/main/index.ts, or a relative require() between these files themselves).
  // These files stay .cts (not .mts) and CommonJS for two reasons that outlived
  // the deploy change: install.cts is require()d as raw source by the Electron
  // app (type-stripped, no build), and the tests require the bridge sources
  // directly. bridge.cts is no longer deployed as raw source — it is bundled
  // (app/build-native-host-bridge.mjs → dist/bridge.js, CJS output) and the BUNDLE is what
  // lands in ~/.hologram — but the sources keep the CJS shape the bundler reads.
  //
  // post-key.mts is the one ESM file here, because it is the one module a layer
  // OUTSIDE this directory ES-imports (app/src/renderer/src/services/records.ts re-exports it —
  // the URL→identity-key rule has to have a single implementation). A .cts
  // could not play that role: tsc reads no exports off `module.exports`, and
  // giving a .cts real `export` statements breaks the raw-source loads below.
  //
  // Sibling requires use the explicit .cts extension (require('./paths.cts'),
  // not require('./paths')) because that is what the source-loading paths
  // (Electron require of install.cts, the tests) resolve at runtime; the bundler
  // follows the same specifiers. Plain require() calls aren't
  // cross-file type-checked by tsc (require() types as NodeRequire → any);
  // that already matches how app/src/main/index.ts's own dynamic computed-path
  // require() of this directory works (see tsconfig.node.json) — each file's
  // OWN logic is still checked, just not the require() contract between them.
  //
  // noImplicitAny stays OFF (same rationale as main/renderer): plain JS-shaped
  // code where internal lambda params would each need annotation noise.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "esModuleInterop": true,
    // Enforce the runtime constraint: Node's type stripping only ERASES types,
    // it cannot transform enums/namespaces/parameter-properties.
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": false,
    // Caught errors stay `any` — bridge.cts/install.cts report `err.message` at
    // several sites; leaving these `any` keeps behavior byte-identical instead
    // of forcing instanceof Error guards.
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // native-host/ has no node_modules of its own (it's a plain deployed dir,
    // not an npm package) — borrow an existing @types install instead of
    // duplicating one here. BOTH candidates are listed because @types/node
    // arrives transitively, so npm is free to place it at the repo root (the
    // usual outcome, since app/ is a workspace and nothing pins a conflicting
    // version) or nested under app/. A missing typeRoots entry is ignored, so
    // listing both is stable across either layout; naming only the app/ path
    // made this project fail with TS2688 after a plain root `npm install`.
    "typeRoots": ["../node_modules/@types", "../app/node_modules/@types"],
    "types": ["node"]
  },
  "files": ["bridge.cts", "install.cts", "paths.cts", "media-download.cts", "config-recovery.cts", "post-key.mts", "post-record.mts"]
}
