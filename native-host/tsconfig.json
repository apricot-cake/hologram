{
  // TypeScript stage 2, native-host half (BACKLOG 採用#1「残り②」= P3): the
  // native-messaging-host layer (bridge.mts + install.mts + paths.mts +
  // media-download.mts + config-recovery.mts).
  //
  // Separate project from tsconfig.node.json / tsconfig.web.json because
  // this is a THIRD runtime: a standalone Node process (spawned by Chrome via
  // native messaging, or via the Electron binary in ELECTRON_RUN_AS_NODE mode).
  //
  // Every file here is ESM (.mts, real `import`/`export`). It was CommonJS until
  // #1052, on a constraint that had expired: the Electron main process loads
  // install.mts as RAW SOURCE by computed absolute path, and its own bundle is
  // CJS, so the load has to be a synchronous require(). Node's require(esm) makes
  // that legal — a CJS caller can require() an ESM module (and type-strip it on
  // the way in) as long as the module has no top-level await, which none of these
  // do. Measured on Electron 43 / Node 24.18 before the conversion.
  //
  // What the CJS shape cost: tsc reads NO exports off a `module.exports = {...}`
  // assignment in a .ts/.cts file — that inference exists for allowJs JS files
  // only, and no `module` setting turns it on (measured 2026-08-08). So every
  // suite that imported one of these modules reported TS2459 and had to be
  // excluded from type-checking entirely (21 of them, scripts/tsconfig.test.json's
  // cause (a)). `export =` is the construct tsc would have understood, and
  // erasableSyntaxOnly below rejects it. ESM is the only shape that is both
  // loadable un-built and readable by tsc.
  //
  // Specifiers name real TS extensions ('./paths.mts', not './paths.js') because
  // that is what every consumer resolves as written: Node's type stripping, the
  // bridge bundler, and Vitest. Unlike the require() calls this replaced, they
  // ARE cross-file type-checked — the contract between these modules is now
  // checked, not just each file's own logic.
  //
  // post-key.mts predates the conversion as the one ESM file here, because it is
  // the one module a layer OUTSIDE this directory ES-imports
  // (app/src/renderer/src/services/records.ts re-exports it — the URL→identity-key
  // rule has to have a single implementation).
  //
  // bridge.mts is not deployed as raw source: it is bundled
  // (app/build-native-host-bridge.mjs → dist/bridge.js, CJS output) and the BUNDLE
  // is what lands in the config dir (paths.mts's configDir()). Its entry guard is
  // an argv[1]-vs-import.meta.url comparison rather than `require.main === module`,
  // which has no ESM spelling that survives both that bundle and the raw source.
  //
  // noImplicitAny stays OFF (same rationale as main/renderer): plain JS-shaped
  // code where internal lambda params would each need annotation noise.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "esModuleInterop": true,
    // Enforce the runtime constraint: Node's type stripping only ERASES types,
    // it cannot transform enums/namespaces/parameter-properties.
    "erasableSyntaxOnly": true,
    // post-record.mts VALUE-imports raw-payload.mts by explicit .mts specifier
    // (#292). The ESM files here name real TS extensions, which both consumers
    // resolve as written — the bridge bundler and Node's type stripping — so tsc
    // has to accept the same specifier. Matches app/tsconfig.node.json, whose
    // main-process files import these very modules the same way.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": false,
    // Caught errors stay `any` — bridge.mts/install.mts report `err.message` at
    // several sites; leaving these `any` keeps behavior byte-identical instead
    // of forcing instanceof Error guards.
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // native-host/ has no node_modules of its own (it's a plain deployed dir,
    // not an npm package) — borrow an existing @types install instead of
    // duplicating one here. BOTH candidates are listed because @types/node
    // arrives transitively, so npm is free to place it at the repo root (the
    // usual outcome, since app/ is a workspace and nothing pins a conflicting
    // version) or nested under app/. A missing typeRoots entry is ignored, so
    // listing both is stable across either layout; naming only the app/ path
    // made this project fail with TS2688 after a plain root `npm install`.
    "typeRoots": ["../node_modules/@types", "../app/node_modules/@types"],
    "types": ["node"]
  },
  "files": ["bridge.mts", "install.mts", "paths.mts", "media-download.mts", "config-recovery.mts", "post-key.mts", "post-record.mts", "inbox.mts", "raw-payload.mts", "protocol.mts"]
}
